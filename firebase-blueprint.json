{
  "entities": {
    "User": {
      "title": "User",
      "description": "ARC Portal system user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "roleId": { "type": "string" },
        "roleName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "fullName", "roleId", "status"]
    },
    "ClubMember": {
      "title": "ClubMember",
      "description": "Registered ARC club member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberNumber": { "type": "string" },
        "fullName": { "type": "string" },
        "idCardNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "memberNumber", "fullName", "idCardNumber", "status"]
    },
    "Role": {
      "title": "Role",
      "description": "RBAC permission role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isSystem": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "BudgetAccount": {
      "title": "BudgetAccount",
      "description": "Financial bank or cash account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "currentBalance": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "accountName", "status"]
    },
    "IncomeRecord": {
      "title": "IncomeRecord",
      "description": "Club income transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "amount", "accountId", "date"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Club expense transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "amount", "accountId", "date"]
    },
    "Event": {
      "title": "Event",
      "description": "Club event or activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "status"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "Daily Ramazan quiz question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "questionNumber": { "type": "number" },
        "questionText": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "questionNumber", "questionText", "status"]
    },
    "SystemInstallation": {
      "title": "SystemInstallation",
      "description": "Installation marker and configuration metadata",
      "type": "object",
      "properties": {
        "initialized": { "type": "boolean" },
        "initializedAt": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["initialized", "version"]
    },
    "ContributionPaymentRequest": {
      "title": "ContributionPaymentRequest",
      "description": "Member fund contribution self-payment submission and approval request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestNumber": { "type": "string" },
        "userId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberNumber": { "type": "string" },
        "memberName": { "type": "string" },
        "year": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "requestNumber", "userId", "memberId", "totalAmount", "status", "submittedAt"]
    }
  },
  "firestore": {
    "/system/installation": {
      "schema": "SystemInstallation",
      "description": "One-time bootstrap installation state"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Portal user accounts"
    },
    "/clubMembers/{memberId}": {
      "schema": "ClubMember",
      "description": "Club members directory"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "System and custom roles"
    },
    "/budgetAccounts/{accountId}": {
      "schema": "BudgetAccount",
      "description": "Financial ledger accounts"
    },
    "/incomeRecords/{incomeId}": {
      "schema": "IncomeRecord",
      "description": "Income records"
    },
    "/expenseRecords/{expenseId}": {
      "schema": "ExpenseRecord",
      "description": "Expense records"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Club events and programs"
    },
    "/quizQuestions/{questionId}": {
      "schema": "QuizQuestion",
      "description": "Ramazan quiz questions"
    },
    "/rentalItems/{itemId}": {
      "schema": "RentalItem",
      "description": "Equipment and gear catalog items available for rental"
    },
    "/rentalUnits/{unitId}": {
      "schema": "RentalUnit",
      "description": "Serialized inventory units with barcodes and condition tracking"
    },
    "/rentalStockMovements/{movementId}": {
      "schema": "RentalStockMovement",
      "description": "Audit trail of inventory movements and status transitions"
    },
    "/rentalRequests/{requestId}": {
      "schema": "RentalRequest",
      "description": "Customer rental booking requests and workflow state"
    },
    "/rentalReservations/{reservationId}": {
      "schema": "RentalReservation",
      "description": "Scheduled inventory reservations preventing double-booking"
    },
    "/rentalBills/{billId}": {
      "schema": "RentalBill",
      "description": "Invoices and return charges bills"
    },
    "/rentalPayments/{paymentId}": {
      "schema": "RentalPayment",
      "description": "Customer payment submissions and verification status"
    },
    "/rentalReceipts/{receiptId}": {
      "schema": "RentalReceipt",
      "description": "Official printable payment receipts with counter sequence"
    },
    "/rentalHandovers/{handoverId}": {
      "schema": "RentalHandover",
      "description": "Handover condition reports with customer digital signature"
    },
    "/rentalReturns/{returnId}": {
      "schema": "RentalReturn",
      "description": "Return inspection logs, condition checks, and calculated charges"
    },
    "/rentalCustomers/{customerUid}": {
      "schema": "RentalCustomer",
      "description": "Google authenticated customer profiles"
    },
    "/rentalRules/{ruleId}": {
      "schema": "RentalRule",
      "description": "Versioned rental terms, regulations, and policies"
    },
    "/rentalSettings/{settingsId}": {
      "schema": "RentalSettings",
      "description": "Global rental service configuration and operational settings"
    },
    "/contributionPaymentRequests/{requestId}": {
      "schema": "ContributionPaymentRequest",
      "description": "Member self-payment contribution requests for review and approval"
    }
  }
}
